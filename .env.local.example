# Auth.js v5 — generate with `openssl rand -base64 33`
AUTH_SECRET=

# Web Push (VAPID) — generate with `npx web-push generate-vapid-keys`.
# VAPID_SUBJECT is a mailto: or https: URL identifying who's sending pushes.
VAPID_SUBJECT=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Neon Postgres — provisioned via the Vercel Marketplace integration.
# Run `vercel env pull .env.local` to fill these in for real; don't hand-type them.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_PROJECT_ID=
PGDATABASE=
PGHOST=
PGHOST_UNPOOLED=
PGPASSWORD=
PGUSER=
POSTGRES_DATABASE=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_PRISMA_URL=
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_URL_NO_SSL=
POSTGRES_USER=

# Cloudflare R2 (media storage) — created manually in the Cloudflare
# dashboard (R2 isn't on the Vercel Marketplace). Bucket + a scoped
# "Object Read & Write" API token, public access via the r2.dev subdomain.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Pusher Channels (realtime) — created manually in the Pusher dashboard
# (not on the Vercel Marketplace either). Channels app, Sandbox plan.
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=
